{
  "name": "volleymanager",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|tamagui|@tamagui/.*)"
    ],
    "testRegex": ".*\\.test\\.(ts|tsx)$"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition"
        ]
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/native": "^7.1.8",
    "@tamagui/babel-plugin": "^2.0.0-rc.41",
    "@tamagui/config": "^2.0.0-rc.41",
    "@tamagui/core": "^2.0.0-rc.41",
    "@tamagui/metro-plugin": "^2.0.0-rc.41",
    "@testing-library/react-native": "^13.3.3",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.0.9",
    "jest": "^29.7.0",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.6",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^17.3.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.0.0-rc.41",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@napi-rs/canvas": "^1.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
